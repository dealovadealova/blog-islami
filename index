<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cahaya Iman - Beranda</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-stone-50 text-stone-800 font-sans antialiased">
    <!-- Header -->
    <header class="max-w-6xl mx-auto px-6 py-16 text-center">
        <h1 class="text-4xl md:text-5xl font-extrabold text-stone-900 mb-6">Meniti Jalan <span class="text-emerald-700">Kebaikan.</span></h1>
        <p class="text-lg text-stone-500 max-w-2xl mx-auto">Kumpulan artikel dan catatan kajian Islami.</p>
    </header>

    <!-- Konten (Nantinya akan dihubungkan dengan artikel dari CMS) -->
    <main class="max-w-6xl mx-auto px-6 pb-24">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            
            <!-- Contoh Tampilan 1 Artikel -->
            <article class="bg-white rounded-2xl shadow-sm border border-stone-100 overflow-hidden flex flex-col">
                <div class="h-48 bg-emerald-800 flex items-center justify-center text-white opacity-90 text-2xl">
                    Gambar Akan Muncul Di Sini
                </div>
                <div class="p-6 flex flex-col flex-grow">
                    <h2 class="text-xl font-bold text-stone-900 mb-3">Keutamaan Bersabar dalam Ujian</h2>
                    <p class="text-stone-600 text-sm mb-6">Setiap kesulitan pasti selalu diiringi dengan kemudahan...</p>
                    <a href="#" class="text-emerald-700 font-semibold text-sm mt-auto">Baca &rarr;</a>
                </div>
            </article>

        </div>
    </main>
</body>
</html>
